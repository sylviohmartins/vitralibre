{
  "name": "vitralibre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint": "node scripts/check.mjs",
    "typecheck": "tsc --allowJs --checkJs --noEmit --target es2022 --module nodenext --moduleResolution nodenext src/core.js src/export.js",
    "build": "node scripts/build.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "node scripts/dev-server.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "jsdom": "27.4.0",
    "axe-core": "4.11.0",
    "jsqr": "1.4.0"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  }
}
